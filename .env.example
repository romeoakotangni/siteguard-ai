# Base de données (Vercel Postgres / Neon)
DATABASE_URL=

# Auth
JWT_SECRET=
SESSION_SECRET=
NEXTAUTH_SECRET=

# KKiaPay (Sandbox + Prod)
# Clés à récupérer sur https://app.kkiapay.me/dashboard (Développeurs > Clés API)
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
KKIAPAY_WEBHOOK_SECRET=
VITE_KKIAPAY_PUBLIC_KEY=

# Mode sandbox (true en dev/test, false en prod)
KKIAPAY_SANDBOX=true

# App
APP_URL=http://localhost:5173
NODE_ENV=development

# Email (facultatif pour magic link)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SiteGuard AI <no-reply@siteguard.ai>"

# Vercel
VERCEL_ENV=development

# AI Agents
OPENROUTER_API_KEY=
DEFAULT_AGENT_MODEL=anthropic/claude-3.5-sonnet

